# ReportPortal deployment — environment overrides
# Copy to `.env` (same directory as docker-compose.yml) and adjust before `docker compose up`.
# Every value below has a working default baked into docker-compose.yml; override the
# credentials before exposing the instance to anything beyond localhost.

# --- Initial superadmin ---
# First login is superadmin / <this password>. Change it in the UI right after first login.
RP_INITIAL_ADMIN_PASSWORD=erebus

# --- PostgreSQL ---
POSTGRES_USER=rpuser
POSTGRES_PASSWORD=rppass
POSTGRES_DB=reportportal

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=rabbitmq

# --- Optional: pin service image tags (defaults are set in docker-compose.yml) ---
# API_IMAGE=reportportal/service-api:5.15.2
# UI_IMAGE=reportportal/service-ui:5.15.3
# UAT_IMAGE=reportportal/service-authorization:5.15.0

# --- MCP server (triage track — see mcp-server.compose.yml) ---
# Personal access token minted in the ReportPortal UI (Profile → API keys) used by the
# MCP server to read launches/analysis on behalf of the triage agent.
RP_MCP_API_TOKEN=
# Host:port other machines use to reach this ReportPortal instance.
RP_MCP_HOST=http://localhost:8080
# Default project the MCP server queries.
RP_MCP_PROJECT=heblo
