{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "start"],
      "port": 3000
    },
    {
      "name": "frontend-automation",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "start:automation"],
      "port": 3001
    },
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/src/Anela.Heblo.API", "--launch-profile", "Development"],
      "port": 5000
    },
    {
      "name": "backend-test",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/src/Anela.Heblo.API", "--launch-profile", "Test"],
      "port": 5001
    }
  ]
}
